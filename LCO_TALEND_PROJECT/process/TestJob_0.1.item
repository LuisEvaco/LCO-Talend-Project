  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="600" posY="120">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_2" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="System.out.println(&quot;Job &quot; + jobName + &quot; started at: &quot; + TalendDate.formatDate(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;, TalendDate.getCurrentDate()));&#xD;&#xA;System.out.println(&quot;Job origin is '&quot; + context.Environment + &quot;'!&quot;);&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;String raw = context.resource_webhook_payload;&#xD;&#xA;&#xD;&#xA;if (raw == null || raw.trim().isEmpty()) {&#xD;&#xA;    throw new RuntimeException(&quot;Webhook payload is empty&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Locate the data field in the TMC webhook envelope&#xD;&#xA;java.util.regex.Pattern pattern = java.util.regex.Pattern.compile(&#xD;&#xA;    &quot;\&quot;data\&quot;\\s*:\\s*\&quot;(\\{.*?\\})\&quot;&quot;,&#xD;&#xA;    java.util.regex.Pattern.DOTALL&#xD;&#xA;);&#xD;&#xA;&#xD;&#xA;java.util.regex.Matcher matcher = pattern.matcher(raw);&#xD;&#xA;&#xD;&#xA;if (!matcher.find()) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;Cannot extract webhook data from TMC payload&quot;&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Extract the inner JSON object&#xD;&#xA;String jsonData = matcher.group(1);&#xD;&#xA;&#xD;&#xA;// Remove optional backslash-newline sequences&#xD;&#xA;jsonData = jsonData.replaceAll(&quot;\\\\\\r?\\n&quot;, &quot;&quot;);&#xD;&#xA;&#xD;&#xA;// Parse the inner JSON&#xD;&#xA;com.google.gson.JsonObject payload =&#xD;&#xA;    com.google.gson.JsonParser.parseString(jsonData)&#xD;&#xA;        .getAsJsonObject();&#xD;&#xA;&#xD;&#xA;// Read the parameters&#xD;&#xA;context.FromDate = payload.get(&quot;FromDate&quot;).getAsString();&#xD;&#xA;context.ToDate = payload.get(&quot;ToDate&quot;).getAsString();&#xD;&#xA;&#xD;&#xA;System.out.println(&quot;FromDate: &quot; + context.FromDate);&#xD;&#xA;System.out.println(&quot;ToDate: &quot; + context.ToDate);&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_2"/>
  </node>
